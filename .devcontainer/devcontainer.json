{
  "name": "Acadia Edu",
  "image": "node:24-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/v1",
  "postCreateCommand": "npm ci --ignore-scripts --no-fund",
  "postStartCommand": "bash ../.devcontainer/start.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Acadia Edu \u2014 open app",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "remoteUser": "node"
}
