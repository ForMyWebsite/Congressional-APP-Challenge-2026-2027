{
  "name": "Acadia Edu",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/v1",
  "postCreateCommand": "npm ci --ignore-scripts --no-fund",
  "postStartCommand": "bash ../.devcontainer/start.sh",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Acadia Edu — open app", "onAutoForward": "openBrowser", "visibility": "private" },
    "3001": { "label": "Internal API", "onAutoForward": "ignore" }
  }
}
