# Server only. Default routing is FREE-ONLY; never use NEXT_PUBLIC_ for this key.
ACADIA_AI_PROVIDER=openrouter
ACADIA_AI_API_KEY=
ACADIA_AI_MODEL=openrouter/free
# Only for a PRIVATE development preview without login; not recommended publicly.
ACADIA_ALLOW_GUEST_AI=false
# Optional paid alternative, only if deliberately chosen:
# ACADIA_AI_PROVIDER=openai
# ACADIA_AI_MODEL=gpt-4.1-mini

# Supabase public project configuration (not service-role credentials).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production app origin (Codespaces detects its forwarded origin automatically).
# ACADIA_APP_ORIGIN=https://your-app.example
